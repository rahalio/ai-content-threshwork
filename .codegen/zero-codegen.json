{
  "domains": [
    {
      "name": "identity",
      "enabled": true,
      "spec_path": "identity.yaml",
      "bundled_path": ".bundled/identity.json"
    }
  ],
  "paths": {
    "project_root": ".",
    "openapi_dir": "packages/openapi-core/src",
    "bundled_dir": "packages/openapi-core/src/.bundled",
    "output": {
      "core": {
        "base": "packages/core/src",
        "imports": {
          "types": "@ddd/core",
          "repositories": "@ddd/core",
          "handlers": "@ddd/core",
          "schemas": "@ddd/core",
          "validators": "@ddd/core",
          "converters": "@ddd/core",
          "shared_helpers": "@ddd/core/_shared/helpers",
          "shared_repositories": "@ddd/core/_shared/repositories",
          "shared_types": "@ddd/core/_shared/types"
        }
      },
      "services": {
        "base": "platform/services/src",
        "imports": {
          "types": "@ddd/core",
          "repositories": "@ddd/core",
          "handlers": "@ddd/core",
          "schemas": "@ddd/core",
          "validators": "@ddd/core",
          "converters": "@ddd/core",
          "shared_helpers": "@ddd/core/_shared/helpers",
          "shared_repositories": "@ddd/core/_shared/repositories",
          "shared_types": "@ddd/core/_shared/types"
        }
      },
      "adapters": {
        "base": "platform/adapters/src",
        "imports": {
          "types": "@ddd/core",
          "repositories": "@ddd/core",
          "handlers": "@ddd/core",
          "schemas": "@ddd/core",
          "validators": "@ddd/core",
          "converters": "@ddd/core",
          "shared_helpers": "@ddd/core/_shared/helpers",
          "shared_repositories": "@ddd/core/_shared/repositories",
          "shared_types": "@ddd/core/_shared/types"
        }
      },
      "api_server": {
        "base": "platform/api-server/src/domains"
      }
    }
  },
  "package_name": "@ddd/core",
  "package_scope": "@ddd",
  "version": "2.0.0"
}

                  "var j = pm.response.json(); if (j.data) { var id = j.data.routingDecisionId || j.data.id; if (id) { pm.collectionVariables.set('routingDecisionId', id); pm.environment.set('routingDecisionId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },

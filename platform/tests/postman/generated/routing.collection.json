{
  "info": {
    "name": "Threshwork Routing API",
    "description": "Work-item intake, rights gating, routing decisions, human review,\nappeals, and statutory/contractual response clocks.\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.threshwork.local"
    },
    {
      "key": "orgId",
      "value": "test-org"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "appealId",
      "value": ""
    },
    {
      "key": "clockId",
      "value": ""
    },
    {
      "key": "workItemId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Routing",
      "item": [
        {
          "name": "listWorkItems",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/work-items?cursor={{cursor}}&limit={{limit}}&queueId={{queueId}}&state={{state}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "work-items"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                },
                {
                  "key": "queueId",
                  "value": "{{queueId}}"
                },
                {
                  "key": "state",
                  "value": "{{state}}"
                }
              ]
            },
            "description": "List work items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('listWorkItems status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); var items = (j.data && j.data.items) || []; if (items.length) { var it = items[0]; var id = it.workItemId || it.id; if (id) { pm.collectionVariables.set('workItemId', id); pm.environment.set('workItemId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "submitWorkItem",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/work-items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "work-items"
              ],
              "query": []
            },
            "description": "Submit work item",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"queueId\": \"newman_queueId\",\n  \"externalReference\": \"\",\n  \"contentType\": \"text\",\n  \"origin\": \"platform_ingest\",\n  \"assetId\": \"newman_assetId\",\n  \"territory\": \"\",\n  \"clockType\": \"statutory_removal\",\n  \"clockDueAt\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('submitWorkItem status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "getRoutingDecision",
          "request": {
            "method": "GET",
            "header": [],

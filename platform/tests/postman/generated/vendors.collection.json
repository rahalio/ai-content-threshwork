{
  "info": {
    "name": "Threshwork Vendors API",
    "description": "Classifier connectors, shadow evaluation against operation golden sets,\nand within-shift traffic cutover.\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.threshwork.local"
    },
    {
      "key": "orgId",
      "value": "test-org"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "queueId",
      "value": ""
    },
    {
      "key": "vendorId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Vendors",
      "item": [
        {
          "name": "listVendorConnectors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/vendors?cursor={{cursor}}&limit={{limit}}&capability={{capability}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "vendors"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                },
                {
                  "key": "capability",
                  "value": "{{capability}}"
                }
              ]
            },
            "description": "List vendor connectors"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('listVendorConnectors status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); var items = (j.data && j.data.items) || []; if (items.length) { var it = items[0]; var id = it.vendorConnectorId || it.id; if (id) { pm.collectionVariables.set('vendorConnectorId', id); pm.environment.set('vendorConnectorId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "registerVendorConnector",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/vendors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "vendors"
              ],
              "query": []
            },
            "description": "Register vendor connector",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Newman Test\",\n  \"vendorClass\": \"tech_giant\",\n  \"capabilities\": null,\n  \"contractedAccuracyFloor\": 0,\n  \"pricePerThousandCalls\": null,\n  \"permittedTerritories\": null,\n  \"processingTermsId\": \"newman_processingTermsId\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('registerVendorConnector status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "listVendorEvaluations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/vendors/{{vendorId}}/evaluations?cursor={{cursor}}&limit={{limit}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "vendors",
                "{{vendorId}}",
                "evaluations"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                }
              ]
            },
            "description": "List vendor evaluations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('listVendorEvaluations status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); var items = (j.data && j.data.items) || []; if (items.length) { var it = items[0]; var id = it.vendorEvaluationId || it.id; if (id) { pm.collectionVariables.set('vendorEvaluationId', id); pm.environment.set('vendorEvaluationId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "startVendorEvaluation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/vendors/{{vendorId}}/evaluations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "vendors",
                "{{vendorId}}",
                "evaluations"
              ],
              "query": []
            },
            "description": "Start vendor evaluation",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"queueId\": \"newman_queueId\",\n  \"goldenSetId\": \"newman_goldenSetId\",\n  \"mode\": \"golden_set_only\",\n  \"sampleSize\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('startVendorEvaluation status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "cutoverVendorTraffic",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/queues/{{queueId}}/vendor-cutover",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "queues",
                "{{queueId}}",
                "vendor-cutover"
              ],
              "query": []
            },
            "description": "Cut over vendor traffic",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetVendorId\": \"newman_targetVendorId\",\n  \"reason\": \"accuracy_drift\",\n  \"rollbackWindowMinutes\": 120\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('cutoverVendorTraffic status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "listGoldenSets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/golden-sets?cursor={{cursor}}&limit={{limit}}&queueId={{queueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "golden-sets"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                },
                {
                  "key": "queueId",
                  "value": "{{queueId}}"
                }
              ]
            },
            "description": "List golden sets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('listGoldenSets status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); var items = (j.data && j.data.items) || []; if (items.length) { var it = items[0]; var id = it.goldenSetId || it.id; if (id) { pm.collectionVariables.set('goldenSetId', id); pm.environment.set('goldenSetId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
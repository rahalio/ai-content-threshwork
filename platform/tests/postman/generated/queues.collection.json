{
  "info": {
    "name": "Threshwork Queues API",
    "description": "Queue registry, policy pinning, weighted scorecards, impact-tier thresholds,\nand automation governance approvals.\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.threshwork.local"
    },
    {
      "key": "orgId",
      "value": "test-org"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "queueId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Queues",
      "item": [
        {
          "name": "listQueues",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/queues?cursor={{cursor}}&limit={{limit}}&impactTier={{impactTier}}&automationStatus={{automationStatus}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "queues"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                },
                {
                  "key": "impactTier",
                  "value": "{{impactTier}}"
                },
                {
                  "key": "automationStatus",
                  "value": "{{automationStatus}}"
                }
              ]
            },
            "description": "List queues"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('listQueues status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); var items = (j.data && j.data.items) || []; if (items.length) { var it = items[0]; var id = it.queueId || it.id; if (id) { pm.collectionVariables.set('queueId', id); pm.environment.set('queueId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "registerQueue",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/queues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "queues"
              ],
              "query": []
            },
            "description": "Register a queue",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Newman Test\",\n  \"taskType\": \"policy_moderation\",\n  \"impactTier\": \"critical_illegal\",\n  \"policyDefinitionId\": \"newman_policyDefinitionId\",\n  \"dailyVolume\": 0,\n  \"averageHandlingTimeSeconds\": 0,\n  \"qualityThreshold\": 0,\n  \"territoryRestrictions\": null\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('registerQueue status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "getQueue",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/queues/{{queueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [

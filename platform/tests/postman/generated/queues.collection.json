          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('getQueue status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); if (j.data) { var id = j.data.queueId || j.data.id; if (id) { pm.collectionVariables.set('queueId', id); pm.environment.set('queueId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },

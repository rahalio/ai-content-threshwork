{
  "info": {
    "name": "Threshwork Portfolio API",
    "description": "Realised benefit metering, egress register, agent exposure ledgers,\nand portfolio roadmap re-scoring.\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.threshwork.local"
    },
    {
      "key": "orgId",
      "value": "test-org"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "agentId",
      "value": ""
    },
    {
      "key": "queueId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Benefits",
      "item": [
        {
          "name": "getBenefitRecord",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/queues/{{queueId}}/benefit?period={{period}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "queues",
                "{{queueId}}",
                "benefit"
              ],
              "query": [
                {
                  "key": "period",
                  "value": "{{period}}"
                }
              ]
            },
            "description": "Get benefit record"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('getBenefitRecord status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); if (j.data) { var id = j.data.benefitRecordId || j.data.id; if (id) { pm.collectionVariables.set('benefitRecordId', id); pm.environment.set('benefitRecordId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Governance",
      "item": [
        {
          "name": "listEgressRecords",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/governance/egress-records?cursor={{cursor}}&limit={{limit}}&queueId={{queueId}}&vendorId={{vendorId}}&period={{period}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "governance",
                "egress-records"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                },
                {
                  "key": "queueId",
                  "value": "{{queueId}}"
                },
                {
                  "key": "vendorId",
                  "value": "{{vendorId}}"
                },
                {
                  "key": "period",
                  "value": "{{period}}"
                }
              ]
            },
            "description": "List egress records"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('listEgressRecords status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); var items = (j.data && j.data.items) || []; if (items.length) { var it = items[0]; var id = it.egressRecordId || it.id; if (id) { pm.collectionVariables.set('egressRecordId', id); pm.environment.set('egressRecordId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "getExposureLedger",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/governance/exposure/{{agentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "governance",
                "exposure",
                "{{agentId}}"
              ],
              "query": []
            },
            "description": "Get exposure ledger"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('getExposureLedger status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); if (j.data) { var id = j.data.exposureLedgerId || j.data.id; if (id) { pm.collectionVariables.set('exposureLedgerId', id); pm.environment.set('exposureLedgerId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Roadmap",
      "item": [
        {
          "name": "listRoadmapEntries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/roadmap?cursor={{cursor}}&limit={{limit}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "roadmap"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                }
              ]
            },
            "description": "List roadmap entries"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('listRoadmapEntries status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); var items = (j.data && j.data.items) || []; if (items.length) { var it = items[0]; var id = it.roadmapEntryId || it.id; if (id) { pm.collectionVariables.set('roadmapEntryId', id); pm.environment.set('roadmapEntryId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "rescoreRoadmap",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/roadmap/rescore",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "roadmap",
                "rescore"
              ],
              "query": []
            },
            "description": "Rescore roadmap",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trigger\": \"scheduled\",\n  \"note\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('rescoreRoadmap status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}